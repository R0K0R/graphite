{
  "name": "graphite",
  "version": "0.1.0",
  "private": true,
  "main": "main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 ${ELECTRON_EXEC:-electron} .\"",
    "build": "vite build",
    "electron": "${ELECTRON_EXEC:-electron} .",
    "start": "npm run build && ${ELECTRON_EXEC:-electron} ."
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "marked": "^15.0.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "y-indexeddb": "^9.0.12",
    "y-monaco": "^0.1.6",
    "y-webrtc": "^10.3.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  }
}
